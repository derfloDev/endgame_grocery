DATABASE_URL=postgres://postgres:postgres@localhost:5432/endgame_grocery
# Required, at least 32 characters, and must not contain "change-me". The server refuses to start otherwise.
# Generate a production value with: openssl rand -base64 48
JWT_SECRET=local-development-secret-do-not-use-in-production
PORT=4000
# Set to "true" only for E2E/test setups: mounts POST /api/test/create-verified-user. Never enable in production.
ENABLE_TEST_ROUTES=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=Endgame Grocery
APP_BASE_URL=http://localhost:5173
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:notifications@example.com
# Frontend icon-match threshold from 0 to 1. Higher values require closer semantic matches.
VITE_ICON_SIMILARITY_THRESHOLD=0.5
